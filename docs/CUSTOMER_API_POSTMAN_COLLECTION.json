{
  "info": {
    "name": "Bitcoin Nail Bar - Customer API (Postgres)",
    "description": "Complete API collection for testing Customer Postgres Migration\n\n**Setup Instructions:**\n1. Import this file into Postman\n2. Set environment variables:\n   - projectId: Your Supabase project ID\n   - publicAnonKey: Your Supabase anon key\n   - adminToken: JWT token from login\n3. Run requests in order for testing\n\n**Date:** 2026-01-23\n**Version:** 1.0 (Postgres Implementation)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Admin CRUD Operations",
      "item": [
        {
          "name": "1.1 List Customers (Paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{publicAnonKey}}",
                "type": "text"
              },
              {
                "key": "X-Session-Token",
                "value": "{{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "https://{{projectId}}.supabase.co/functions/v1/make-server-84f9c112/customers?page=1&limit=20",
              "protocol": "https",
              "host": [
                "{{projectId}}",
                "supabase",
                "co"
              ],
              "path": [
                "functions",
                "v1",
                "make-server-84f9c112",
                "customers"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
